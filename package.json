{
  "name": "@abstracter/atomic-release",
  "version": "0.0.0",
  "description": "Automated atomic release using the command pattern.",
  "private": false,
  "type": "module",
  "types": "./build/index.d.ts",
  "exports": {
    "types": "./build/index.d.ts",
    "default": "./build/index.js"
  },
  "files": [
    "build/**",
    "CHANGELOG.md",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abstracter-io/atomic-release.git"
  },
  "scripts": {
    "outdated": "npx npm-check -u",
    "lint": "eslint --format pretty --fix",
    "lint:all": "npm run lint -- .",
    "prepare": "husky",
    "build": "tsc --build tsconfig.compile.json --pretty",
    "postbuild": "copyfiles -u 1 src/**/*.d.ts build",
    "test": "vitest run",
    "release": "node scripts/release.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=18.16.0"
  },
  "keywords": [
    "release",
    "changelog",
    "atomic release",
    "command pattern",
    "semantic version",
    "version management",
    "conventional version",
    "conventional changelog"
  ],
  "license": "MIT",
  "devDependencies": {
    "@abstracter/atomic-release": "^2.1.1",
    "@abstracter/eslint-config": "^2.0.0",
    "@commitlint/cli": "^19.4.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@commitlint/cz-commitlint": "^19.4.0",
    "@vitest/coverage-v8": "^2.0.5",
    "commitizen": "^4.3.0",
    "copyfiles": "^2.4.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.8.0",
    "eslint-formatter-pretty": "^6.0.1",
    "git-cz": "^4.9.0",
    "husky": "^9.1.4",
    "lint-staged": "^15.2.8",
    "micromatch": "^4.0.7",
    "npm-check": "^6.0.1",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "await-to-js": "^3.0.0",
    "colors": "^1.4.0",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "conventional-changelog-preset-loader": "^5.0.0",
    "conventional-changelog-writer": "^8.0.0",
    "conventional-commits-parser": "^6.0.0",
    "fetch-defaults": "^1.0.0",
    "mime": "^4.0.4",
    "parse-author": "^2.0.0",
    "parse-github-url": "^1.0.3",
    "pretty-ms": "^9.1.0",
    "radash": "^12.1.0",
    "read-package-up": "^11.0.0",
    "semver": "^7.6.3",
    "uri-templates": "^0.2.0"
  }
}
