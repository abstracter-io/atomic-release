/* Visit https://aka.ms/tsconfig.json to read more about this file */
{
  "compilerOptions": {
    "lib": ["es2020"],
    "noLib": false,
    "target": "es2020",
    "module": "commonjs",
    "allowJs": true,
    "declaration": true,
    "outDir": "./build",
    "removeComments": false,
    "strictNullChecks": true,

    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    "paths": {
      "@abstracter/atomic-release/*": ["./src/*"]
    },
  },

  "include": [
    "src",
    "node_modules/conventional-changelog-conventionalcommits/index.d.ts"
  ],

  "exclude": [
    "node_modules"
  ]
}
